{
  "name": "@agent-harness/scaffold",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.4",
  "workspaces": [
    "."
  ],
  "scripts": {
    "dev": "turbo run frontend:dev --filter=@agent-harness/scaffold",
    "build": "turbo run frontend:build tauri:build --filter=@agent-harness/scaffold",
    "test": "turbo run test:unit --filter=@agent-harness/scaffold",
    "test:e2e": "turbo run test:e2e:run --filter=@agent-harness/scaffold",
    "lint": "turbo run lint:eslint lint:rust --filter=@agent-harness/scaffold",
    "typecheck": "turbo run typecheck:ts typecheck:rust --filter=@agent-harness/scaffold",
    "tauri:dev": "turbo run tauri:dev:run --filter=@agent-harness/scaffold",
    "frontend:dev": "vite dev --host 127.0.0.1 --port 1420",
    "frontend:build": "vite build",
    "tauri:build": "tauri build",
    "test:unit": "vitest run",
    "test:e2e:run": "playwright test",
    "lint:eslint": "eslint .",
    "lint:rust": "cd src-tauri && cargo clippy --all-targets --all-features -- -D warnings",
    "typecheck:ts": "tsc --noEmit",
    "typecheck:rust": "cd src-tauri && cargo check --all-targets --all-features",
    "tauri:dev:run": "tauri dev"
  },
  "dependencies": {
    "@tanstack/react-query": "5.100.6",
    "@tanstack/react-router": "1.168.26",
    "@tauri-apps/api": "2.10.1",
    "react": "19.2.5",
    "react-dom": "19.2.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.59.1",
    "@tailwindcss/vite": "4.2.4",
    "@tauri-apps/cli": "2.10.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "25.6.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "eslint": "10.2.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "29.1.0",
    "prettier": "3.8.3",
    "tailwindcss": "4.2.4",
    "turbo": "2.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.59.1",
    "vite": "8.0.10",
    "vitest": "4.1.5"
  }
}
