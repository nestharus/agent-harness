{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agent Harness",
  "version": "0.0.0",
  "identifier": "dev.agentharness.scaffold",
  "build": {
    "beforeDevCommand": "bun run frontend:dev",
    "beforeBuildCommand": "bun run frontend:build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Agent Harness",
        "width": 1100,
        "height": 760,
        "minWidth": 800,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb"
    ],
    "icon": [
      "icons/icon.png"
    ]
  }
}
